NODE_ENV=development
DEPLOYMENT_ID=node-template-dev
PORT=3000
APP_TIME_ZONE=Asia/Shanghai
DB_TIME_ZONE=+08:00

DATABASE_URL=mysql://node_app:CHANGE_DATABASE_PASSWORD@127.0.0.1:3306/node_template
MYSQL_ROOT_PASSWORD=CHANGE_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=node_template
MYSQL_USER=node_app
MYSQL_PASSWORD=CHANGE_DATABASE_PASSWORD
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306
JWT_SECRET=CHANGE_TO_32_PLUS_RANDOM_CHARACTERS
JWT_EXPIRES_IN=2h

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379
# Global prefix for every Redis key. Change it for each independent deployment.
CACHE_NAMESPACE=node-template:development

PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_SECONDS=900
CAPTCHA_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=180

# 0 = do not trust X-Forwarded-For. Set to the exact proxy hop count only
# when every request reaches the app through infrastructure you control.
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000
ASSET_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true

SEED_ADMIN_USERNAME=admin
# Required by pnpm db:seed; choose a local-only value of at least 12 characters.
SEED_ADMIN_PASSWORD=CHANGE_TO_A_LOCAL_12_PLUS_CHARACTER_PASSWORD
