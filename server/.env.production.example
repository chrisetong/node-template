NODE_ENV=production
# Unique per independent deployment on the same Docker host.
DEPLOYMENT_ID=change_to_unique_deployment_id
COMPOSE_PROJECT_NAME=change_to_unique_compose_project
APP_TIME_ZONE=Asia/Shanghai
DB_TIME_ZONE=+08:00

APP_IMAGE=node-template-app:local
# Frontend build-time paths. The production admin SPA is served under /admin/.
VITE_API_BASE_URL=/api
VITE_APP_BASE=/admin/
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

MYSQL_DATABASE=change_to_unique_database_name
DATABASE_URL=mysql://node_app:CHANGE_DATABASE_PASSWORD@db:3306/change_to_unique_database_name
MYSQL_ROOT_PASSWORD=CHANGE_MYSQL_ROOT_PASSWORD
MYSQL_USER=node_app
MYSQL_PASSWORD=CHANGE_DATABASE_PASSWORD
JWT_SECRET=CHANGE_TO_32_PLUS_RANDOM_CHARACTERS
JWT_EXPIRES_IN=2h

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
# Global prefix for every Redis key. It must be unique per independent deployment.
CACHE_NAMESPACE=change_to_unique_redis_prefix

PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_SECONDS=900
CAPTCHA_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=180

TRUST_PROXY_HOPS=2
CORS_ORIGIN=https://admin.example.com
API_BASE_URL=https://admin.example.com/api
ASSET_BASE_URL=https://admin.example.com
SWAGGER_ENABLED=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD
